# انسخ هذا الملف باسم .env وعدّل القيم — لا ترفع .env الحقيقي إلى GitHub أبدًا

# المنفذ الذي يستمع عليه الخادم (Render يحدده تلقائيًا عبر متغير PORT، لا تغيّره هناك)
PORT=3847
HOST=0.0.0.0

# مدة صلاحية جلسة تسجيل دخول الطاقم بالساعات
SESSION_TTL_HOURS=12

# اجعلها true دائمًا في بيئة الإنتاج (HTTPS)
COOKIE_SECURE=true

# دومين موقعك بالضبط (بدون / في النهاية) — يمكن وضع أكثر من دومين مفصول بفواصل
CORS_ORIGINS=https://pc-cheak.gt.tc

# بيانات أول حساب أدمن يُنشأ تلقائيًا عند أول تشغيل فقط
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD_12+
